# syntax=docker/dockerfile:1

ARG GO_IMAGE=golang:1.25.11-alpine
ARG RUNTIME_IMAGE=alpine:3.22

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build \
	-trimpath \
	-buildvcs=false \
	-ldflags="-s -w" \
	-o /out/flick-worker \
	./cmd/flick-worker

FROM ${RUNTIME_IMAGE} AS runtime
RUN apk add --no-cache ca-certificates tzdata \
	&& addgroup -S flick \
	&& adduser -S -D -H -G flick flick

WORKDIR /app
COPY --from=build /out/flick-worker /usr/local/bin/flick-worker

# State lives in PostgreSQL (FLICK_WORKER_DATABASE_URL, required at boot); the
# image carries no data volume.

USER flick

ENTRYPOINT ["/usr/local/bin/flick-worker"]

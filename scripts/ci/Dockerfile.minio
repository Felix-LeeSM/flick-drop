# MinIO's community registry images are no longer available. Build the CI-only
# fixture from official source commits, using the repository's Go toolchain.
FROM golang:1.25.11-alpine AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
# RELEASE.2025-10-15T17-29-55Z
RUN go install github.com/minio/minio@v0.0.0-20251015172955-9e49d5e7a648
# RELEASE.2025-08-13T08-35-41Z
RUN go install github.com/minio/mc@v0.0.0-20250813083541-7394ce0dd2a8

FROM alpine:3.22
COPY --from=build /go/bin/minio /go/bin/mc /usr/local/bin/
ENTRYPOINT ["minio"]

# Flick local environment contract.
# Copy values into .env.local and keep .env.local untracked.

FLICK_ENV=development
FLICK_LOG_LEVEL=debug
# json (default, production) or text (local dev readability).
FLICK_LOG_FORMAT=text
# OpenTelemetry OTLP/HTTP collector URL for distributed tracing. Empty disables
# tracing (no collector dependency); set e.g. http://otel-collector:4318 to enable.
# No path uses /v1/traces; explicit paths (including /) are preserved.
FLICK_OTLP_ENDPOINT=

# Public web/API URLs.
FLICK_PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_FLICK_API_BASE_URL=http://localhost:8080
# Build-time mirrors of the server TTL config (defaults match internal/config/defaults.go;
# scripts/ci/ttl-drift.sh enforces the match).
PUBLIC_FLICK_MIN_TTL_SECONDS=300
PUBLIC_FLICK_MAX_TTL_SECONDS=604800
PUBLIC_FLICK_DEFAULT_TTL_SECONDS=3600
FLICK_API_BASE_URL=http://localhost:8080
FLICK_INTERNAL_API_BASE_URL=http://localhost:8080
FLICK_API_ADDR=:8080

# Internal auth for worker -> api calls. Set a strong local value.
FLICK_INTERNAL_TOKEN=change-me-local
# Bearer token guarding /metrics (Prometheus scrape). Separate from the internal token.
FLICK_METRICS_TOKEN=change-me-metrics-local
# Worker's dedicated /metrics listen address (same bearer token). Set empty to disable.
# FLICK_WORKER_METRICS_ADDR=:9091

# NATS JetStream.
FLICK_NATS_URL=nats://127.0.0.1:4222
FLICK_NATS_STREAM=FLICK_JOBS
FLICK_NATS_JOB_SUBJECT=flick.jobs

# PostgreSQL 17: one instance, two logical databases, each owned by its own
# least-privilege role (compose.yaml + scripts/dev/postgres-init.sql create
# the local roles/databases). Both DSNs are required: each entrypoint fails
# fast when its DSN is empty.
FLICK_DATABASE_URL=postgres://flick_api:flick_api@127.0.0.1:5432/flick_api?sslmode=disable
FLICK_WORKER_DATABASE_URL=postgres://flick_worker:flick_worker@127.0.0.1:5432/flick_worker?sslmode=disable

# Valkey: shared rate limiter and live-transfer rendezvous state. Runs
# non-persistent (`--save "" --appendonly no`) and stores hashed keys only —
# never ciphertext (security-model.md).
FLICK_VALKEY_ADDR=127.0.0.1:6379
# Deployment-secret salt mixed into rate-limit keys, so Valkey never holds a
# raw client network. Rotating it only resets in-flight rate-limit buckets.
FLICK_RATELIMIT_KEY_SALT=change-me-local

# Live-transfer stream listener: the port is the same on every API replica, and
# FLICK_POD_IP is this pod's IP from the Kubernetes Downward API. Empty
# FLICK_POD_IP (one host outside Kubernetes) advertises 127.0.0.1.
FLICK_INTERNAL_HTTP_PORT=8081
FLICK_POD_IP=

# Storage thresholds. Inline counts the age-encrypted file and must be at least
# an empty age file (4128 bytes, secrets.MaxCiphertextBytes(0)); the maximum
# file size counts plaintext.
FLICK_PAYLOAD_INLINE_MAX_BYTES=1048576
FLICK_MAX_FILE_BYTES=268435456
FLICK_DEFAULT_TTL_SECONDS=3600
FLICK_MIN_TTL_SECONDS=300
FLICK_MAX_TTL_SECONDS=604800
FLICK_OPEN_RATE_PER_MIN=10
FLICK_CREATE_RATE_PER_MIN=5
# Expiration reaper: sweep expired/orphan secrets out of the flick_api database.
FLICK_REAPER_INTERVAL_SECONDS=60
FLICK_REAPER_BATCH_SIZE=50
# Live pipe relay: real-time streaming transfer with zero storage. Needs
# FLICK_VALKEY_ADDR (waiting rooms live in Valkey); without it /api/pipe/* is 503.
FLICK_PIPE_RELAY_ENABLED=true
FLICK_PIPE_MAX_CONCURRENT=100
# Trusted proxy CIDRs (comma-separated) whose peer may set X-Forwarded-For. Empty = direct peer IP only.
FLICK_TRUSTED_PROXIES=

# S3-compatible object storage for payloads above the inline threshold.
# FLICK_STORAGE_BACKENDS lists backend names (lower-case letter, then up to 15
# lower-case letters or digits); empty keeps every payload inline in the
# database. Each name reads FLICK_STORAGE_<NAME>_* with <NAME> upper-cased.
# Left commented on purpose: scripts/dev/up.sh defaults to one local MinIO
# backend named "minio" (FLICK_DEV_SKIP_MINIO=1 switches storage off), and a
# value copied into .env.local would override that default.
# FLICK_STORAGE_BACKENDS=minio
# FLICK_STORAGE_MINIO_ENDPOINT=http://localhost:9000
# FLICK_STORAGE_MINIO_REGION=us-east-1
# FLICK_STORAGE_MINIO_BUCKET=flick-dev
# FLICK_STORAGE_MINIO_ACCESS_KEY_ID=minioadmin
# FLICK_STORAGE_MINIO_SECRET_ACCESS_KEY=minioadmin
# FLICK_STORAGE_MINIO_PATH_STYLE=true
# Cumulative object bytes allowed on this backend (flick_api database
# aggregate). 0 or unset = unlimited, allowed only with a single backend.
# FLICK_STORAGE_MINIO_MAX_TOTAL_BYTES=

# A second backend pools another provider's free tier. With several backends,
# every one needs a positive MAX_TOTAL_BYTES: each new object goes to a random
# backend weighted by its remaining space (storage-model.md).
# FLICK_STORAGE_BACKENDS=oci,r2
# FLICK_STORAGE_OCI_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# FLICK_STORAGE_OCI_REGION=<region>
# FLICK_STORAGE_OCI_BUCKET=flick-oci
# FLICK_STORAGE_OCI_ACCESS_KEY_ID=
# FLICK_STORAGE_OCI_SECRET_ACCESS_KEY=
# FLICK_STORAGE_OCI_MAX_TOTAL_BYTES=18000000000
# FLICK_STORAGE_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# FLICK_STORAGE_R2_REGION=auto
# FLICK_STORAGE_R2_BUCKET=flick-r2
# FLICK_STORAGE_R2_ACCESS_KEY_ID=
# FLICK_STORAGE_R2_SECRET_ACCESS_KEY=
# FLICK_STORAGE_R2_MAX_TOTAL_BYTES=9000000000
